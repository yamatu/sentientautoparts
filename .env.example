# Copy to .env, replace all placeholders. Never reuse the old site's secrets.
HTTP_PORT=8090
SITE_URL=http://localhost:8090
SITE_NAME=sentientautoparts
SITE_DESCRIPTION=Automotive air conditioning parts and vehicle fitment catalog
# Optional verified logo path, e.g. /legacy/theme/images/your-logo.png
SITE_LOGO=
# B2B inquiry UI. Set false + rebuild frontend to restore retail admin entries.
B2B_MODE=true
MYSQL_DATABASE=sentientautoparts
MYSQL_USER=sentient
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
REVALIDATE_SECRET=replace-with-at-least-32-random-characters
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set true when serving HTTPS. After first boot, set SEED_DEFAULT_ADMIN=false.
AUTH_COOKIE_SECURE=false
